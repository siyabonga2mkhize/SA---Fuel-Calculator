# Supabase (create a free project, then copy these from Project Settings > API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# OpenRouteService (free API key for geocoding + road routing)
VITE_ORS_API_KEY=YOUR_OPENROUTESERVICE_KEY

# Public SA fuel price API; the default is the free public service
VITE_FUEL_API_URL=https://sa-fuel-api.railway.app
